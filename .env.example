# Financial RAG Pipeline Configuration
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
DENSE_EMBEDDING_DIM=384
BM25_K1=1.5
BM25_B=0.75
HYBRID_ALPHA=0.5
RERANK_TOP_K=10
CITATION_MIN_CONFIDENCE=0.7
DOCUMENT_STORAGE_PATH=./data/docs
VECTOR_STORAGE_PATH=./data/vectors
LOG_LEVEL=INFO

# RAG Reranker & Semantic Cache Configuration
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.88
SEMANTIC_CACHE_MAX_ENTRIES=1000
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
CROSS_ENCODER_TOP_K=10
